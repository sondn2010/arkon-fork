# ============================================================
# Snapper — Docker Compose environment
# cp .env.docker.example .env.docker
# ============================================================

# --- PostgreSQL ---
# POSTGRES_* are used by the postgres container; DATABASE_URL must match them
POSTGRES_USER=snapper
POSTGRES_PASSWORD=snapper_secret
POSTGRES_DB=snapper
DATABASE_URL=postgresql+asyncpg://snapper:snapper_secret@postgres:5432/snapper

# --- Auth (JWT) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-string

# --- Default Admin Account ---
DEFAULT_ADMIN_EMAIL=admin@snapper.local
DEFAULT_ADMIN_PASSWORD=admin123

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=snapper-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_HOURS=24

# --- MinIO Storage Tuning (optional) ---
# Storage class: standard (no EC), with EC:n enable erasure coding with n parity drives
# e.g. MINIO_STORAGE_CLASS_STANDARD=EC:2
# MINIO_CACHE_DRIVES: comma-separated mount paths for caching (e.g. /mnt/cache1,/mnt/cache2)
# MINIO_CACHE_EXCLUDE: cache exclusion patterns (e.g. "*.pdf,*.mp4")
# MINIO_CACHE_QUOTA: max cache usage as percentage of disk (e.g. 80)
# MINIO_CACHE_AFTER: number of accesses before caching (e.g. 3)
# MINIO_STORAGE_CLASS_STANDARD=EC:0

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=600

# --- CORS ---
# Production: set to your actual domain, e.g. https://arkon.yourcompany.com
CORS_ORIGINS=*

# --- Frontend ---
# Public URL of the API as seen by the browser
NEXT_PUBLIC_API_URL=http://localhost:5055
